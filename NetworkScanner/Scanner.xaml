<Page x:Class="NetworkScanner.Scanner"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
      mc:Ignorable="d"
      Title="Scanner" 
      d:DesignHeight="600" d:DesignWidth="1000">

    <Grid Background="#0D0F12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" 
                Background="#141720" 
                Padding="12,10"
                Margin="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Filter:" 
                           Foreground="#64748B" 
                           FontWeight="SemiBold"
                           FontSize="14"
                           VerticalAlignment="Center" 
                           Margin="0,0,12,0"/>

                <TextBox x:Name="FilterTextBox"
                         Grid.Column="1"
                         Background="#1A1F2E"
                         Foreground="White"
                         CaretBrush="White"
                         BorderThickness="0"
                         Padding="10,6"
                         FontSize="14"
                         VerticalContentAlignment="Center"
                         TextChanged="CheckFilter">
                    <TextBox.Resources>
                        <Style TargetType="{x:Type Border}">
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </TextBox.Resources>
                </TextBox>

                <Button x:Name="StopButton"
                        Grid.Column="2"
                        Content="Stop Sniffing"
                        Margin="12,0,0,0"
                        Padding="18,0"
                        Height="32"
                        Background="#DC2626"
                        Foreground="White"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        Click="StopButton_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="StopBorder" Background="{TemplateBinding Background}" CornerRadius="4">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="StopBorder" Property="Background" Value="#B91C1C"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="StopBorder" Property="Background" Value="#1E2535"/>
                                    <Setter Property="Opacity" Value="0.6"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button x:Name="SavePcapButton"
                        Grid.Column="3"
                        Content="Save to PCAP"
                        IsEnabled="False"
                        Margin="8,0,0,0"
                        Padding="18,0"
                        Height="32"
                        Background="#3B82F6"
                        Foreground="White"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        Click="SavePcapButton_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="SaveBorder" Background="{TemplateBinding Background}" CornerRadius="4">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="SaveBorder" Property="Background" Value="#1E2535"/>
                                    <Setter TargetName="SaveBorder" Property="Opacity" Value="0.5"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="SaveBorder" Property="Background" Value="#2563EB"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>

        <DataGrid x:Name="PacketsGrid"
                  RowHeaderWidth="0"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserResizeRows="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="None"
                  Background="#141720"
                  Foreground="White"
                  BorderThickness="0"
                  FontSize="14"
                  IsReadOnly="True"
                  EnableRowVirtualization="True"
                  EnableColumnVirtualization="True"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  ScrollViewer.CanContentScroll="True"
                  ScrollViewer.IsDeferredScrollingEnabled="True">

            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#141720"/>
                    <Setter Property="Foreground" Value="#64748B"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Padding" Value="10,8"/>
                    <Setter Property="BorderThickness" Value="0"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>

            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="Margin" Value="0 0 0 12"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                </Style>
            </DataGrid.RowStyle>

            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell">
                    <Setter Property="Padding" Value="12,10"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="Background" Value="#141720"/>
                </Style>
            </DataGrid.CellStyle>

            <DataGrid.Columns>
                <DataGridTextColumn Header="Time" Binding="{Binding Timestamp, StringFormat=HH:mm:ss.fff}" Width="120"/>
                <DataGridTextColumn Header="Protocol" Binding="{Binding Protocol}" Width="90"/>
                <DataGridTextColumn Header="IP Source" Binding="{Binding SrcEndpoint}" Width="*"/>
                <DataGridTextColumn Header="IP Destination" Binding="{Binding DstEndpoint}" Width="*"/>
                <DataGridTextColumn Header="MAC Source" Binding="{Binding MacSrc}" Width="160"/>
                <DataGridTextColumn Header="MAC Destination" Binding="{Binding MacDst}" Width="160"/>
                <DataGridTextColumn Header="Length" Binding="{Binding Length}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>

        <Button x:Name="ScrollToBottomButton"
                Grid.Row="1"
                Width="42"
                Height="42"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,14,14"
                Click="ScrollToBottomButton_Click"
                Visibility="Collapsed"
                Panel.ZIndex="9"
                Cursor="Hand"
                BorderThickness="0"
                Focusable="False"
                ToolTip="Back to latest packets">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="#141720"
                            CornerRadius="21"
                            BorderBrush="#3B82F6"
                            BorderThickness="2">
                        <TextBlock Text="↓"
                                   FontSize="22"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Opacity" Value="0.9"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Opacity" Value="0.75"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>

        <Grid x:Name="BottomPanelRoot"
              Grid.RowSpan="2"
              VerticalAlignment="Bottom"
              Panel.ZIndex="10">

            <Grid.RenderTransform>
                <TranslateTransform x:Name="PanelTransform" Y="270"/>
            </Grid.RenderTransform>

            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="270"/>
            </Grid.RowDefinitions>

            <ToggleButton x:Name="BottomHandleButton"
                          Grid.Row="0"
                          Width="120"
                          Height="40"
                          HorizontalAlignment="Center"
                          Background="Transparent"
                          BorderThickness="0"
                          Cursor="Hand">

                <ToggleButton.Triggers>
                    <EventTrigger RoutedEvent="ToggleButton.Checked">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="PanelTransform"
                                                 Storyboard.TargetProperty="Y"
                                                 To="0"
                                                 Duration="0:0:0.25"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                    <EventTrigger RoutedEvent="ToggleButton.Unchecked">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="PanelTransform"
                                                 Storyboard.TargetProperty="Y"
                                                 To="270"
                                                 Duration="0:0:0.25"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </ToggleButton.Triggers>

                <ToggleButton.Template>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="RootBorder"
                                Background="#3B82F6"
                                CornerRadius="12,12,0,0">

                            <Image Source="Icons/Arrow.png"
                                   Width="28"
                                   Height="28"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   RenderTransformOrigin="0.5,0.5">
                                <Image.RenderTransform>
                                    <ScaleTransform x:Name="ArrowFlip" ScaleY="1"/>
                                </Image.RenderTransform>
                            </Image>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RootBorder" Property="Background" Value="#2563EB"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ArrowFlip"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="-1"
                                                             Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ArrowFlip"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="1"
                                                             Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </ToggleButton.Template>
            </ToggleButton>

            <Border Grid.Row="1"
                    Background="#141720"
                    Padding="40">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Protocol Distribution (Racing Bars)"
                               Foreground="#64748B"
                               FontSize="14"
                               Margin="0,0,0,10"/>

                    <lvc:CartesianChart Grid.Row="1"
                                        DataContext="{Binding ProtocolVM}"
                                        Series="{Binding Series}"
                                        XAxes="{Binding XAxes}"
                                        YAxes="{Binding YAxes}"
                                        TooltipPosition="Hidden"/>
                </Grid>
            </Border>
        </Grid>

        <!-- SECURITY ALERT OVERLAY -->
        <Grid x:Name="AlertOverlay"
              Grid.RowSpan="2"
              Visibility="Collapsed"
              Panel.ZIndex="99"
              Background="#99000000">

            <Border Width="400"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#141720"
                    CornerRadius="8">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" ShadowDepth="6" BlurRadius="24" Opacity="0.6"/>
                </Border.Effect>

                <StackPanel>

                    <!-- Red title bar -->
                    <Border Background="#7F1D1D" CornerRadius="8,8,0,0" Padding="16,10">
                        <Grid>
                            <TextBlock x:Name="AlertTypeLabel"
                                       Foreground="White"
                                       FontWeight="SemiBold"
                                       FontSize="14"
                                       VerticalAlignment="Center"/>
                            <Button HorizontalAlignment="Right"
                                    Width="24" Height="24"
                                    Cursor="Hand"
                                    Click="AlertClose_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="XBorder" Background="Transparent" CornerRadius="4">
                                            <TextBlock Text="✕" Foreground="#FCA5A5" FontSize="13"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="XBorder" Property="Background" Value="#991B1B"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Body -->
                    <StackPanel>
                        <TextBlock x:Name="AlertTargetLabel"
                                   Foreground="#94A3B8"
                                   FontSize="12"
                                   Margin="0,0,0,8"/>
                        <TextBlock x:Name="AlertDetailsLabel"
                                   TextWrapping="Wrap"
                                   Foreground="#CBD5E1"
                                   FontSize="13"
                                   LineHeight="20"/>
                        <TextBlock x:Name="AlertTimeLabel"
                                   Foreground="#475569"
                                   FontSize="11"
                                   Margin="0,10,0,0"/>
                    </StackPanel>

                    <!-- Buttons -->
                    <Border Background="#0D0F12" CornerRadius="0,0,8,8" Padding="16,10">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">

                            <Button Width="80" Height="30" Margin="0,0,8,0"
                                    Cursor="Hand" Click="AlertClose_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="B" Background="#1E2535" CornerRadius="5">
                                            <TextBlock Text="Dismiss" Foreground="#94A3B8" FontSize="13"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="B" Property="Background" Value="#263045"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <Button Width="120" Height="30"
                                    Cursor="Hand" Click="AlertBlock_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="B" Background="#991B1B" CornerRadius="5">
                                            <TextBlock Text="Block Threat" Foreground="White" FontSize="13"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="B" Property="Background" Value="#7F1D1D"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                        </StackPanel>
                    </Border>

                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</Page>
